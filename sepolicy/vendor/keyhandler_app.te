# The alert-slider handler: a platform-signed, system-UID app that runs its own
# UEventObserver for the tri-state switch. It is started as a Service by
# BootCompletedReceiver, so it needs the kernel uevent netlink socket itself.

type keyhandler_app, domain, coredomain;
app_domain(keyhandler_app)

# Kernel uevents for the tri-state switch (switch-class and extcon).
# app.te:573 neverallows write/append on this class for appdomain, and
# UEventObserver only reads the uevents, so those two are excluded.
allow keyhandler_app self:netlink_kobject_uevent_socket {
    create read getattr setattr lock bind connect getopt setopt shutdown map
};

# Its own storage; seapp_contexts labels it system_app_data_file, and these
# mirror what system_app.te grants for that type.
allow keyhandler_app system_app_data_file:dir create_dir_perms;
allow keyhandler_app system_app_data_file:{ file lnk_file } create_file_perms;

# Services it looks up by name. binder_call to system_server itself already
# comes from app.te's binder_call(appdomain, binderservicedomain).
allow keyhandler_app audio_service:service_manager find;
allow keyhandler_app notification_service:service_manager find;
allow keyhandler_app vibrator_service:service_manager find;
allow keyhandler_app activity_service:service_manager find;

# Bind the always-alive slider HAL. It reuses the hal_lineage_touch attribute,
# and this app is keyhandler_app rather than system_app, so it needs the client
# attribute explicitly (system_app already has it).
hal_client_domain(keyhandler_app, hal_lineage_touch)
