# Always-alive authority for the alert slider. A vendor HAL is restarted by
# init and never killed by the app killer, so it observes every movement even
# while a framework-side consumer is dead, and serves the current position to
# a restarted client. It uses the hal_lineage_touch HAL attribute so the
# existing lineage touch client plumbing applies.

type hal_slider_oneplus_msm8998, domain;
type hal_slider_oneplus_msm8998_exec, exec_type, vendor_file_type, file_type;

hal_server_domain(hal_slider_oneplus_msm8998, hal_lineage_touch)
init_daemon_domain(hal_slider_oneplus_msm8998)

# Registering the service with servicemanager. The kernel checks this exchange in
# two steps: binder_transaction() asks for { call } before the transaction carries
# the service's binder object, which binder_transfer_binder() then checks as
# { transfer }. The device capture only ever showed { call }, because the
# transaction is refused there and the object transfer is never reached; both are
# needed, so use the pair rather than a bare call.
binder_call(hal_slider_oneplus_msm8998, servicemanager)

# Logging. The service routes every line through libbase's KernelLogger
# (service.cpp sets android::base::KernelLogger) and its .rc declares no
# `file /dev/kmsg w`, so libbase opens /dev/kmsg itself. inode_permission()
# checks that open as { write } and only selinux_file_open() adds { open }, the
# latter solely because the open_perms policy capability is enabled here, so
# w_file_perms is required to cover both. This is a logging channel, not the
# cause of the startup abort.
allow hal_slider_oneplus_msm8998 kmsg_device:chr_file w_file_perms;

# Kernel uevents for the tri-state slider. write/append are excluded because
# app.te:573 neverallows them for appdomain and the class is read-only here.
allow hal_slider_oneplus_msm8998 self:netlink_kobject_uevent_socket {
    create read getattr setattr lock bind connect getopt setopt shutdown map
};

# Callback path. The HAL reports the slider position to the client it stored,
# keyhandler_app, through IAlertSliderCallback.onStateChanged, so the binder
# direction is HAL -> client app. AOSP grants exactly this direction for its own
# callback-capable HAL pairs (system/sepolicy/private/hal_audio.te carries both
# binder_call(hal_audio_client, hal_audio_server) and the server -> client
# counterpart for callbacks); the shared device/lineage hal_lineage_touch.te
# only declares the client -> server line, which is why nothing covered this
# once the HAL stopped dying at registration.
#
# Grant { call } alone rather than the whole binder_call() macro. The interface
# is `oneway void onStateChanged(int)`, so the transaction carries a primitive,
# transfers no binder object and has no reply, which means { transfer } and fd
# use are never exercised; the avc denial names { call } alone, which says the
# same thing from the other side. If the interface ever hands over a binder
# object or an fd, add that one permission instead of widening to the macro.
allow hal_slider_oneplus_msm8998 keyhandler_app:binder call;
