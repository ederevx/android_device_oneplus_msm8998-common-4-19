allow hal_usb_qti vendor_sysfs_usb_c:dir r_dir_perms;
allow hal_usb_qti vendor_sysfs_usb_c:lnk_file r_file_perms;
allow hal_usb_qti vendor_sysfs_usb_c:file rw_file_perms;
allow hal_usb_qti sysfs_usb_data_enabled:file w_file_perms;

# Role-HAL reads the USB gadget UDC dir (/sys/class/udc -> sysfs_udc) to
# apply role compositions; mirrors vndr qva hal_usb.te allow.
allow hal_usb_qti sysfs_udc:dir search;
